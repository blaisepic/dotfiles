#!/usr/bin/env python3
import json
import os
import sys
from datetime import datetime, timezone


def main():
    if len(sys.argv) != 2 or sys.argv[1] != 'get':
        return 0
    fields = dict(line.rstrip('\n').split('=', 1) for line in sys.stdin if '=' in line)
    try:
        if fields.get('protocol') != 'https' or fields.get('host', '').lower() != 'github.com':
            return 0
        path = fields.get('path', '').removesuffix('.git').strip('/')
        expected = os.environ.get('MAC_AGENT_REPOSITORY', '')
        if path != expected or path.count('/') != 1:
            return 0
        with open(os.environ.get('MAC_AGENT_LEASE_FILE', '/run/mac-agent/github/lease.json')) as f:
            lease = json.load(f)
        expiry = datetime.fromisoformat(lease['expires_at'].replace('Z', '+00:00'))
        if lease.get('repository') != expected or expiry <= datetime.now(timezone.utc) or not lease.get('token'):
            return 0
        print('protocol=https\nhost=github.com\nusername=x-access-token\npassword=' + lease['token'] + '\n')
    except (OSError, ValueError, KeyError, TypeError):
        return 0
    return 0

if __name__ == '__main__':
    raise SystemExit(main())
