#!/bin/sh
set -eu
if [ "${1:-}" = import-auth ]; then
  mkdir -p /home/worker/.codex
  install -m 0600 /dev/stdin /home/worker/.codex/auth.json
  exit 0
fi
repository=$(python3 -c 'import json; print(json.load(open("/run/mac-agent/github/lease.json"))["repository"])' 2>/dev/null || true)
if [ -n "$repository" ]; then
  export MAC_AGENT_REPOSITORY="$repository"
  export MAC_AGENT_LEASE_FILE=/run/mac-agent/github/lease.json
  git config --file /tmp/worker.gitconfig credential.useHttpPath true
  git config --file /tmp/worker.gitconfig credential.helper /usr/local/bin/git-credential-mac-agent
  export GIT_CONFIG_GLOBAL=/tmp/worker.gitconfig
fi
if [ -f /home/worker/.codex/mac-agent-session ]; then
  exec codex exec resume --last --dangerously-bypass-approvals-and-sandbox -C /workspace
fi
exec codex exec --dangerously-bypass-approvals-and-sandbox -C /workspace - < /run/mac-agent/brief.txt
